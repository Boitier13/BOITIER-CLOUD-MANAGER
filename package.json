{
  "name": "boitier-cloud-manager",
  "private": true,
  "version": "0.2.0",
  "description": "BOITIER CLOUD MANAGER — gestionnaire local multi-cloud (Google Drive réel en lecture seule)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "dev:preview": "VITE_HMR_CLIENT_PORT=443 vite",
    "desktop:typecheck": "tsc -p desktop/tsconfig.json",
    "desktop:build": "node desktop/build.mjs",
    "desktop": "npm run build && npm run desktop:build && electron .",
    "desktop:dev": "npm run desktop:build && node desktop/dev.mjs",
    "desktop:test": "node desktop/test/smoke.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.1.1",
    "lucide-react": "^0.469.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.7",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.4.11",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  },
  "main": "desktop/dist/main.cjs"
}
