{
  "name": "boitier-cloud-manager",
  "private": true,
  "version": "0.23.15",
  "description": "BOITIER CLOUD MANAGER — gestionnaire local multi-cloud (Google Drive, MEGA, Shadow Drive et TeraBox)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "dev:preview": "VITE_HMR_CLIENT_PORT=443 vite",
    "desktop:typecheck": "tsc -p desktop/tsconfig.json",
    "desktop:build": "node desktop/build.mjs",
    "desktop": "npm run build && npm run desktop:build && electron .",
    "desktop:dev": "npm run desktop:build && node desktop/dev.mjs",
    "desktop:test": "node desktop/test/smoke.mjs && node desktop/test/shadow.mjs && node desktop/test/terabox-web.mjs && node desktop/test/terabox-coexistence.mjs && node desktop/test/terabox-isolation.mjs && node desktop/test/transfer-queue.mjs && node desktop/test/transfer-reload.mjs && node desktop/test/transfer-cancel.mjs && node desktop/test/mega-transfer-control.mjs && node desktop/test/update-launcher.mjs && node desktop/test/mega-session.mjs && node desktop/test/catalogue-performance.mjs",
    "verify:desktop": "npm run typecheck && npm run desktop:typecheck && npm run build && npm run desktop:build && npm run desktop:test && npm run verify:interface && npm run desktop:paths && npm run desktop:package-test",
    "desktop:paths": "node desktop/test/verify-paths.mjs",
    "package:win": "npm run build && npm run desktop:build && electron-builder --win nsis --x64",
    "package:dir": "npm run build && npm run desktop:build && electron-builder --dir",
    "desktop:package-test": "node desktop/test/verify-package.mjs",
    "verify:interface": "node desktop/test/verify-interface.mjs"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/inter": "^5.1.1",
    "@fontsource-variable/manrope": "^5.3.0",
    "fast-xml-parser": "^5.12.1",
    "lucide-react": "^0.469.0",
    "megajs": "^1.3.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.7",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^40.10.6",
    "electron-builder": "^25.1.8",
    "electron-updater": "^6.8.11",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  },
  "main": "desktop/dist/main.cjs",
  "build": {
    "appId": "com.boitier.cloudmanager",
    "productName": "BOITIER CLOUD MANAGER",
    "copyright": "© Boitier13",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "desktop/dist/main.cjs",
      "desktop/dist/preload.cjs",
      "package.json",
      "!**/*.map",
      "!node_modules/**/*"
    ],
    "extraMetadata": {
      "main": "desktop/dist/main.cjs"
    },
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "BOITIER-CLOUD-MANAGER-${version}-setup.${ext}",
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "BOITIER CLOUD MANAGER",
      "uninstallDisplayName": "BOITIER CLOUD MANAGER",
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Boitier13",
        "repo": "BOITIER-CLOUD-MANAGER",
        "releaseType": "release"
      }
    ]
  },
  "author": {
    "name": "Boitier13"
  }
}
